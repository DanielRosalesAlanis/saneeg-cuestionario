# Copy this file to .env.local and adjust values for your environment.
# .env.local is gitignored and never committed.

# When set to the exact string "true", src/api/aplicaciones.js uses an
# in-memory mock instead of calling the real backend, letting the
# questionnaire flow be exercised without the Spring Boot backend running.
# Must be "false" (or unset) in production and in any environment that
# talks to the real backend.
VITE_MOCK_BACKEND=false
